# stdlib
from datetime import datetime
from typing import Any

# ################################################################################################################################
# ################################################################################################################################

class PulledMessageBuilder:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def build(self, lease: Any, audit_log: Any | None, crypto_manager: Any) -> None: ...

# ################################################################################################################################
# ################################################################################################################################

class SubscriptionList:
    STATUS_CONFIRMED: str
    STATUS_PENDING: str
    STATUS_PENDING_REMOVAL: str

    def __init__(self) -> None: ...
    def replace(self, subscribers: dict[str, dict[str, Any]], committed: list[tuple[str, str]]) -> None: ...
    def set_topics(self, sub_key: str, is_pub_active: bool, topics: dict[str, dict[str, bool]]) -> list[str]: ...
    def remove(self, sub_key: str) -> list[str]: ...
    def mark_committed(self, added: list[tuple[str, str]], removed: list[tuple[str, str]] = ...) -> None: ...
    def replace_committed(self, committed: list[tuple[str, str]]) -> None: ...
    def replace_subscribers(self, subscribers: dict[str, dict[str, Any]]) -> None: ...
    @staticmethod
    def is_governed(sub_key: str) -> bool: ...
    def decide_subscribers(self, topic: str, row_sub_keys: list[str]) -> tuple[list[str], list[tuple[str, str]]]: ...
    def is_loaded(self) -> bool: ...
    def pairs_for_topic(self, topic: str) -> list[str]: ...
    def topics_of(self, sub_key: str) -> list[str]: ...
    def removed_topics(self, sub_key: str) -> list[str]: ...
    def delivered_topics(self, sub_key: str) -> list[str] | None: ...
    def withholds_pair(self, sub_key: str, topic: str) -> bool: ...
    def is_publish_allowed(self, sub_key: str, topic: str) -> bool: ...
    def rename_topic(self, old_name: str, new_name: str) -> None: ...
    def remove_topic(self, topic: str) -> list[str]: ...
    def differences(self) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]: ...
    def has_unconfirmed(self) -> bool: ...
    def statuses(self) -> list[tuple[str, str, str]]: ...

# ################################################################################################################################
# ################################################################################################################################

def encode_pull_response(cid: str, status: str, messages: list[Any]) -> str: ...
def encode_push_envelope_parts(envelope: dict[str, Any], payload_key: str) -> tuple[bytes, bytes]: ...
def escape_push_payload(data: str) -> bytes: ...
def extract_search_text(data: str) -> str: ...
def utc_now() -> datetime: ...

